{
 "id": "theoretical_debate",
 "kind": "alternative",
 "title": "Belief-driven versus identity-driven sharing of misinformation",
 "rationale": "The source found misinformation lowered sharing by 18.2 points and plausibility by 18.6 points, so the two moved together. Sharer ideology was not randomized (moderate sharer −1.9 points, p=0.034), and both outcomes were forced choices, so the source could not test whether source ideology pulls sharing away from plausibility. This design randomizes source ideology and measures both outcomes on separate scales.",
 "contribution": "Tests whether source ideology shifts sharing intent more than perceived accuracy, which separates belief-driven from identity-driven sharing.",
 "limitations": [
  "Stated sharing intent is not real sharing behavior.",
  "Headline topics may differ in partisan salience, so topic is randomized and controlled.",
  "Source ideology is signaled by a named outlet and may not match real contacts.",
  "Tertiles of belief in disputed claims are measured, not randomized."
 ],
 "design": {
  "title": "Source ideology, accuracy judgements and sharing intent",
  "overview": "Respondents first report belief in disputed claims and their own ideology. Each is then randomly assigned to one source type (co-ideological, opposed, or neutral) and sees four headlines (two false, two true) from that source. For each headline they rate accuracy and sharing intent on separate 1-7 scales, giving a within-subject comparison of the two outcomes.",
  "hypothesis": "If sharing follows belief, the source effect on sharing equals its effect on accuracy. If identity drives sharing, the co-ideological source effect on sharing exceeds its effect on accuracy, especially for false headlines and among respondents in the top tertile of belief in disputed claims.",
  "primaryOutcome": "Difference between sharing intent and accuracy rating (both standardized), by source condition, headline veracity and belief tertile.",
  "comparison": "Co-ideological versus opposed and neutral source; outcome (share vs accuracy) by source interaction, moderated by belief tertile and headline veracity.",
  "population": "US adults, quota-sampled to include conservatives, moderates and liberals, with Latino adults oversampled. About 1,500 per arm.",
  "conditions": [
   {
    "id": "co",
    "title": "Co-ideological source",
    "description": "Headlines attributed to an outlet matching the respondent's ideology.",
    "nodeId": "arm_co"
