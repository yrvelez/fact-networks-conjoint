import importlib.util, pathlib
_spec = importlib.util.spec_from_file_location('reg', pathlib.Path(__file__).with_name('03_registered.py')); reg = importlib.util.module_from_spec(_spec); _spec.loader.exec_module(reg)
import pandas as pd, numpy as np
import matplotlib; matplotlib.use('Agg')
import matplotlib.pyplot as plt

df = pd.read_csv('data/clean.csv')
H = reg.HYPOTHESES
if isinstance(H, dict):
    h1 = H['H1']
else:
    h1 = [h for h in H if h.get('id') == 'H1' or h.get('analysis_id') == 'H1'][0]
est = h1['estimator']; outcome = h1.get('outcome', 'share'); cov = h1.get('covariates', []) or []

def run(sub):
    sub = sub.reset_index(drop=True)
    f, d2 = reg.build_formula(outcome, est, cov, sub)
    d2 = d2.reset_index(drop=True)
    r = reg.fit(d2, f, est)
    out = {}
    for lev in ['Misinformation', 'Fact-check']:
        k = [i for i in r.params.index if 'T.' + lev in i and 'arm_code' in i]
        out[lev] = (float(r.params[k[0]]), float(r.bse[k[0]])) if k else (np.nan, np.nan)
    return out, int(r.nobs)

rows = []
base, nb = run(df)
for lev, (b, s) in base.items():
    rows.append(dict(group='All', level=lev, estimate=b, std_error=s, n=nb))
for g in ['Lowest', 'Middle', 'Highest']:
    o, n = run(df[df['media_t'] == g])
    for lev, (b, s) in o.items():
        rows.append(dict(group='media trust ' + g, level=lev, estimate=b, std_error=s, n=n))
e1 = pd.DataFrame(rows); e1.to_csv('results/E1_media_trust_het.csv', index=False)
m = e1[(e1.level == 'Misinformation')]
print('E1 misinfo effect by media trust:', '; '.join(f"{a}={b:.3f}({c:.3f})" for a, b, c in zip(m.group, m.estimate, m.std_error)))

d = df.copy()
d['pickA'] = np.where(d['chosen_share'].isna(), np.nan, ((d['profile'] == 'A') == (d['chosen_share'] == 1)).astype(float))
sl = d.groupby('resp_id')['pickA'].transform(lambda x: (x.dropna().nunique() == 1) and x.notna().sum() >= 4)
sub = d[~sl]
alt, na = run(sub)
rows = []
for lev in base:
    rows.append(dict(level=lev, orig_estimate=base[lev][0], orig_se=base[lev][1], orig_n=nb,
                     alt_estimate=alt[lev][0], alt_se=alt[lev][1], alt_n=na))
e2 = pd.DataFrame(rows); e2.to_csv('results/E2_straightline_excl.csv', index=False)
print(f"E2 excluding straight-liners (n {nb}->{na}): misinfo {base['Misinformation'][0]:.3f}->{alt['Misinformation'][0]:.3f}, se {base['Misinformation'][1]:.3f}->{alt['Misinformation'][1]:.3f}")

fig, ax = plt.subplots(figsize=(5, 3))
mm = e1[e1.level == 'Misinformation'].reset_index(drop=True)
ax.errorbar(mm.estimate, range(len(mm)), xerr=1.96 * mm.std_error, fmt='o', color='#b22', ecolor='#222')
ax.set_yticks(range(len(mm))); ax.set_yticklabels(mm.group); ax.axvline(0, color='#222', lw=.8)
ax.set_xlabel('Misinformation effect on sharing')
for s in ['top', 'right', 'left']: ax.spines[s].set_visible(False)
ax.grid(False); fig.tight_layout(); fig.savefig('figures/E1_media_trust.png', dpi=200, facecolor='white')
